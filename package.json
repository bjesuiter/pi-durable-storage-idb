{
  "name": "pi-durable-storage-idb",
  "version": "0.1.0",
  "description": "Transactional IndexedDB storage for Pi Durable, built with idb",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjesuiter/pi-durable-storage-idb.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:browser && npm run test:e2e && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "idb": "8.0.4"
  },
  "peerDependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "devDependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "4.1.11",
    "fake-indexeddb": "^6.2.0",
    "playwright": "^1.58.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.4",
    "vitest": "4.1.11"
  }
}
